# Puerto HTTP
PORT=3000
# Ruta de la base de datos SQLite
DB_PATH=./data/asistencia.db
# Usuario administrador inicial (solo se crea si no existe ningún usuario)
ADMIN_EMAIL=admin@colegio.edu
ADMIN_PASSWORD=cambie-esta-clave
# Cada cuántos segundos se revisan las listas vencidas para notificar
SCHEDULER_INTERVAL_SECONDS=30
# Si corre detrás de un proxy/HTTPS (Nginx, Render, Railway...): true
TRUST_PROXY=

# ---- WhatsApp ----
# simulado | meta | twilio
WHATSAPP_PROVIDER=simulado
# Código de país para teléfonos sin prefijo internacional (51 = Perú)
WHATSAPP_DEFAULT_COUNTRY_CODE=51

# Meta WhatsApp Business Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Plantilla aprobada (opcional pero necesaria para mensajes iniciados por el colegio)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=es

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
